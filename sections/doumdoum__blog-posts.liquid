{{ "doumdoum__blog-posts.css"| asset_url | stylesheet_tag }}

<section class="doumdoum__custom-blog-articles page-width section--{{ section.id }}">
  <div class="doumdoum__custom-blog-articles_container blog-articles-container">
    <div class="blog-articles-title">
      <h3>{{ section.settings.container_title }}</h3>
      <p>{{ section.settings.container_info }}</p>
      <div class="container_btn">
        <a class="doumdoum_podcast" href="{{ section.settings.podcast_link }}">{{ section.settings.podcast_title }}
          <span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="23"
              height="23"
              viewBox="0 0 23 23"
              fill="none">
              <path
                d="M9.59766 7.30664L15.3205 7.30664L15.3205 13.0295"
                stroke="#F570B7"
                stroke-width="1.5"
                stroke-miterlimit="10"
                stroke-linecap="round"
                stroke-linejoin="round" />
              <path
                d="M7.30664 15.3203L15.2404 7.38658"
                stroke="#F570B7"
                stroke-width="1.5"
                stroke-miterlimit="10"
                stroke-linecap="round"
                stroke-linejoin="round" />
            </svg>
          </span>
        </a>
        <a class="doumdoum_blog" href="{{ section.settings.blog_link }}">{{ section.settings.blog_title }}</a>
      </div>
    </div>
    <div class="blog-articles-grid">
      {% for block in section.blocks %}
        <div class="article-content" {{ block.shopify_attributes }}>

          {% if block.type == 'article_block' %}
            {% assign article = block.settings.selected_article %}

            {% if article != blank %}
              <img
                src="{{ article.image | image_url: width: 160 }}"
                width="{{ article.image.width }}"
                height="{{ article.image.height }}"
                alt="{{ article.title }}">

              <div class="article-info-container">
                <h3>{{ article.title }}</h3>
                <p class="article-excerpt">{{ article.excerpt }}</p>
                <a href="{{ article.url }}">Lire la suite
                  <span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 16 16"
                      fill="none">
                      <path
                        d="M9.62012 3.95312L13.6668 7.99979L9.62012 12.0465"
                        stroke="#414651"
                        stroke-width="1.5"
                        stroke-miterlimit="10"
                        stroke-linecap="round"
                        stroke-linejoin="round" />
                      <path
                        d="M2.33301 8L13.553 8"
                        stroke="#414651"
                        stroke-width="1.5"
                        stroke-miterlimit="10"
                        stroke-linecap="round"
                        stroke-linejoin="round" />
                    </svg>
                  </span>
                </a>
              </div>

            {% else %}

              <div class="placeholder-image">{{ 'image' | placeholder_svg_tag }}</div>

              <div class="article-info-container">
                <h3>Titre de l'article</h3>
                <p>Extrait de l'article...</p>
                <a href="#">Lire la suite
                  <span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 16 16"
                      fill="none">
                      <path
                        d="M9.62012 3.95312L13.6668 7.99979L9.62012 12.0465"
                        stroke="#414651"
                        stroke-width="1.5"
                        stroke-miterlimit="10"
                        stroke-linecap="round"
                        stroke-linejoin="round" />
                      <path
                        d="M2.33301 8L13.553 8"
                        stroke="#414651"
                        stroke-width="1.5"
                        stroke-miterlimit="10"
                        stroke-linecap="round"
                        stroke-linejoin="round" />
                    </svg>
                  </span>
                </a>
              </div>
            {% endif %}

          {% elsif block.type == 'video_block' %}
            {% assign video = block.settings.video_link %}


            {% if video != blank %}

              {% assign video_id = video.id %}
              <img
                src="https://img.youtube.com/vi/{{ video_id }}/hqdefault.jpg"
                width="160"
                height="160"
                alt="Couverture vidéo">
              <div class="article-info-container">
                <h3>{{ block.settings.custom_title | default: video.title }}</h3>
                <a href="{{ video.url }}">YouTube Podcast
                  <span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 16 16"
                      fill="none">
                      <path
                        d="M9.62012 3.95312L13.6668 7.99979L9.62012 12.0465"
                        stroke="#414651"
                        stroke-width="1.5"
                        stroke-miterlimit="10"
                        stroke-linecap="round"
                        stroke-linejoin="round" />
                      <path
                        d="M2.33301 8L13.553 8"
                        stroke="#414651"
                        stroke-width="1.5"
                        stroke-miterlimit="10"
                        stroke-linecap="round"
                        stroke-linejoin="round" />
                    </svg>
                  </span>
                </a>
              </div>
            {% else %}

              <div class="placeholder-image">{{ 'image' | placeholder_svg_tag }}</div>
              <div class="article-info-container">
                <h3>Titre du Podcast</h3>
                <p>Description de la vidéo...</p>
                <a href="#">YouTube Podcast
                  <span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none">
                      <path
                        d="M14.9902 17.5H16.5002C19.5202 17.5 22.0002 15.03 22.0002 12C22.0002 8.98 19.5302 6.5 16.5002 6.5H14.9902"
                        stroke="#353535"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round" />
                      <path
                        d="M9 6.5H7.5C4.47 6.5 2 8.97 2 12C2 15.02 4.47 17.5 7.5 17.5H9"
                        stroke="#353535"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round" />
                      <path
                        d="M8 12H16"
                        stroke="#353535"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round" />
                    </svg>
                  </span>
                </a>
              </div>
            {% endif %}

          {% endif %}
        </div>
      {% endfor %}
    </div>

  </div>
</section>
<style>
  
</style>

{% schema %}
  {
    "name": "Custom Articles de Blog ",
    "settings": [
      {
        "type": "text",
        "id": "container_title",
        "label": "Titre de la section",
        "default": "Conseils & Astuces pour Bébé"
      },
      {
        "type": "text",
        "id": "container_info",
        "label": "Info de la section",
        "default": "Découvrez des conseils pratiques, des guides utiles et des astuces d'experts pour prendre Comment prendre soin de votre bébé au quotidien."
      },
      {
        "type": "url",
        "id": "podcast_link",
        "label": "Lien vers les podcastes"
      },
      {
        "type": "url",
        "id": "blog_link",
        "label": "Lien vers le Blog"
      }, {
        "type": "text",
        "id": "podcast_title",
        "label": "Text vers les podcastes",
        "default": "DoumDoum podcast"
      }, {
        "type": "text",
        "id": "blog_title",
        "label": "Text vers les blogs",
        "default": "Blog"
      }

    ],
    "max_blocks": 3,
    "blocks": [
      {
        "type": "article_block",
        "name": "Article de blog",
        "settings": [
          {
            "type": "article",
            "id": "selected_article",
            "label": "Choisir l'article"
          }
        ]
      }, {
        "type": "video_block",
        "name": "Vidéo YouTube / Podcast",
        "settings": [
          {
            "type": "video_url",
            "id": "video_link",
            "label": "Lien YouTube",
            "accept": ["youtube"],
            "info": "Le titre et la couverture seront utilisés."
          }, {
            "type": "text",
            "id": "custom_title",
            "label": "Titre personnalisé",
            "info": "Laisser vide pour utiliser le titre de la vidéo"
          }, {
            "type": "textarea",
            "id": "description",
            "label": "Description courte"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Custom Articles de Blog",
        "blocks": [
          {
            "type": "article_block"
          }, {
            "type": "article_block"
          }, {
            "type": "video_block"
          }
        ]
      }
    ]
  }
{% endschema %}