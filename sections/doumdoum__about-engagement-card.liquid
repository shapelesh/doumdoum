<section class="doumdoum__about-engagement-card page-width">
  <div class="doumdoum__about-engagement-card-header">
    <h2>{{ section.settings.engagment_title }}</h2>
    <p>{{ section.settings.engagment_text }}</p>
  </div>
  <div class="doumdoum__about-engagement-card-container">
    {% for block in section.blocks limit: 3 %}
      {% assign card_class = "doumdoum_card" %}
      {% if forloop.first %}
        {% assign card_class = "doumdoum_card doumdoum_card-pink" %}
      {% elsif forloop.last %}
        {% assign card_class = "doumdoum_card doumdoum_card-pink" %}
      {% endif %}

      <div class="{{ card_class }}" {{ block.shopify_attributes }}>
        <div class="doumdoum_card-approved">
          <span class="check"></span>
        </div>
        <div class="doumdoum_card-icon">
          <img
            src="{{ block.settings.card_icon |  image_url: width: block.settings.card_icon.width  }}"
            width="{{ block.settings.card_icon.width }}"
            height="{{ block.settings.card_icon.height }}"
            alt="{{ block.settings.card_icon.alt }}"
            loading="lazy">
        </div>
        <div class="doumdoum_card-text">
          <h3>{{ block.settings.card_text }}</h3>
        </div>
      </div>
    {% endfor %}
  </div>
</section>
<style>
  .doumdoum__about-engagement-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 24px;
    padding: 13px 201px 119.96px;
  }
  .doumdoum__about-engagement-card-header {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 10px;
  }
  .doumdoum__about-engagement-card-header h2 {
    font-family: Fredoka;
    font-weight: 500;
    font-style: Medium;
    font-size: 34px;
    leading-trim: NONE;
    line-height: 120%;
    letter-spacing: -0.75%;
    text-align: center;
    vertical-align: middle;
    color: #181D27;
    margin: 0;
  }
  .doumdoum__about-engagement-card-header p {
    font-family: Nunito;
    font-weight: 500;
    font-style: Medium;
    font-size: 16px;
    leading-trim: NONE;
    line-height: 120%;
    letter-spacing: -0.5%;
    text-align: center;
    vertical-align: middle;
    color: #181D27;
    margin: 0;
  }
  .doumdoum__about-engagement-card-container {
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  .doumdoum_card {
    position: relative;
    max-width: 280.66px;
    min-height: 231.04px;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: #D7EDFF;
    padding: 12px;
    border-radius: 16px;
  }
  .doumdoum_card .doumdoum_card-icon {
    max-width: 149px;
    max-height: 163px;
    width: 100%;
    height: 100%;
  }
  .doumdoum_card-text h3 {
    font-family: Fredoka;
    font-weight: 500;
    font-style: Medium;
    font-size: 18px;
    leading-trim: NONE;
    line-height: 120%;
    letter-spacing: -0.75%;
    text-align: center;
    color: #226E7B;
  }
  .doumdoum_card.doumdoum_card-pink {
    background-color: #FFE1CE;
  }
  .doumdoum_card.doumdoum_card-pink .doumdoum_card-text h3 {
    color: #8E431D;
  }
  .doumdoum_card-approved {
    width: 100%;
  }
  .doumdoum_card-approved .check {
    position: absolute;
    top: 31px;
    left: 31px;
    width: 10px;
    height: 6px;
    border-left: 3px solid #fff;
    border-bottom: 3px solid #fff;
    transform: rotate(-45deg);
    z-index: 3;
  }
  .doumdoum_card-approved::before {
    content: "";
    position: absolute;
    top: 18px;
    left: 18px;
    width: 36px;
    height: 34.15px;
    border-radius: 50%;
    background-color: #FFFFFF;
    z-index: 1;
  }
  .doumdoum_card-approved::after {
    content: "";
    position: absolute;
    top: 23px;
    left: 23px;
    width: 26px;
    height: 24.15px;
    border-radius: 50%;
    background-color: #D7EDFF;
    z-index: 2;
  }
  .doumdoum_card.doumdoum_card-pink .doumdoum_card-approved::after {
    background-color: #FFE1CE;
  }
  @media screen and (max-width: 990px) {
    .doumdoum__about-engagement-card {
      padding: 13px 90px 119.96px;
    }
  }
  @media screen and (max-width: 768px) {
    .doumdoum__about-engagement-card {
      padding: 13px 40px 70.09 x;
    }
  }
  @media screen and (max-width: 646px) {
    .doumdoum__about-engagement-card-container {
      flex-direction: column;
      flex-wrap: nowrap;
    }
    .doumdoum_card {
      max-width: 70%;
      min-height: 231.04px;
    }
  }
  @media screen and (max-width: 500px) {
    .doumdoum__about-engagement-card {
      padding: 13px 16px 70.09px;
    }
    .doumdoum__about-engagement-card-header {
      width: 100%;
      align-items: flex-start;
    }
    .doumdoum__about-engagement-card-header h2 {
      font-size: 24px;
      text-align: start;
    }
    .doumdoum__about-engagement-card-header p {
      font-size: 14px;
      text-align: start;
    }
    .doumdoum_card {
      max-width: 100%;
      min-height: 231.04px;
    }
  }
</style>
{% schema %}
  {
    "name": "Engagement Doumdoum",
    "settings": [
      {
        "type": "text",
        "id": "engagment_title",
        "label": "Titre des Engagements",
        "default": "Notre engagement"
      }, {
        "type": "text",
        "id": "engagment_text",
        "label": "Sous-titre des Engagements",
        "default": "Des soins sûrs, doux et fiables, conçus pour accompagner votre bébé chaque jour en toute confiance."
      }
    ],
    "blocks": [
      {
        "type": "card",
        "name": "Carte d'engagement",
        "settings": [
          {
            "type": "image_picker",
            "id": "card_icon",
            "label": "Icône de la carte",
            "info": "Recommandé : format PNG ou SVG avec fond transparent."
          }, {
            "type": "text",
            "id": "card_text",
            "label": "Texte de la carte",
            "default": "Titre de la carte",
            "placeholder": "Entrez votre texte ici"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Engagements Doumdoum",
        "blocks": [
          {
            "type": "card"
          }, {
            "type": "card"
          }, {
            "type": "card"
          }
        ]
      }
    ]
  }
{% endschema %}