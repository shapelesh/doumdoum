{{ "doumdoum__product-section.css" | asset_url | stylesheet_tag }}

<script>
  window.doumdoumSettings = window.doumdoumSettings || {};
  window.doumdoumSettings.sectionId = "{{ section.id }}";
  window.doumdoumSettings.moneyFormat = {{ shop.money_format | json }};
</script>
<script src="{{ 'doumdoum__product-section.js' | asset_url }}" defer></script>

<section class="doumdoum__custom-product-section section--{{ section.id }} {{ product.title }}--{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="doumdoum__custom-product-section_container-grid">
    <div class="container-grid__images">
      <div class="product-gallery">
        <div class="product-main-image" id="MainImageContainer-{{ section.id }}">
          <img
            id="MainImage-{{ section.id }}"
            src="{{ product.featured_media | img_url: '800x' }}"
            alt="{{ product.featured_media.alt | escape }}"
            width="100%"
            height="100%"
            loading="lazy">
        </div>
        <div class="product-thumbnails-container glide" data-slider="productGallery">
          <div class="glide__track" data-glide-el="track">
            <ul class="glide__slides product-thumbnails-slider" id="ThumbSlider-{{ section.id }}">
              {% for media in product.media %}
                <li class="glide__slide thumb-item {% if forloop.first %}active{% endif %}" onclick="updateMainImage('{{ media | image_url: width: 800 }}', this)">
                  <img
                    src="{{ media | image_url: width: 150 }}"
                    alt="{{ media.alt | escape }}"
                    width="100%"
                    height="100%"
                    loading="lazy">
                </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div class="container-grid__card-info card-info">
      <div class="card-info_title-price">
        <div class="card-info_reviews">
          {% render 'hero-yellow-stars' %}
          <span>
            {{ section.settings.review_text }}
          </span>
        </div>
        <h1>{{ product.title }}</h1>
        <span>{{ product.price | money_without_trailing_zeros }}</span>
      </div>
      <div class="card-info_benifits-list">
        {% render 'meta_benefits'
          , benefits: product.metafields.custom.product_benfits %}
      </div>
      <div class="card-info_quantity-container">
        <input
          type="hidden"
          name="quantity"
          id="Quantity-{{ section.id }}"
          value="1">

        {% for i in (1..3) %}
          <button
            type="button"
            class="qty-btn {% if i == 1 %}active{% endif %} static-qty-btn"
            id="qty-btn-{{ i }}"
            onclick="selectQuantity({{ i }}, this)">
            {{ i }}x
          </button>
        {% endfor %}

        <div class="card-info_custom-select-wrapper" id="custom-select-wrapper">
          <button
            type="button"
            class="qty-btn"
            id="custom-qty-trigger"
            onclick="toggleDropdown()">
            <span id="custom-qty-btn-text"></span>
            <svg
              class="chevron-icon"
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </button>

          <div class="qty-dropdown-list" id="qty-dropdown">
            {% for i in (4..9) %}
              <div class="qty-dropdown-item" onclick="selectQuantity({{ i }}, null, true)">{{ i }}x</div>
            {% endfor %}
            <div class="qty-dropdown-item" onclick="showManualInput()">10+</div>
          </div>

          <input
            type="number"
            id="manual-qty-input"
            class="qty-btn manual-input"
            style="display: none;"
            min="10"
            placeholder="Nb..."
            oninput="updateManualQuantity(this.value)">
        </div>
      </div>
      <div class="card-info_tabs-container">

        <div class="tabs-header">
          {%- assign details_val = product.metafields.custom.details -%}
          {%- assign usage_val = product.metafields.custom.utilisations -%}
          {%- assign ingredient_val = product.metafields.custom.ingredient_desc -%}

          <button
            type="button"
            class="tab-btn selected"
            data-tab="details"
            data-content="{{ details_val | escape }}">
            {{ 'doumdoum.products.productTabs.details' | t }}

          </button>

          <button
            type="button"
            class="tab-btn"
            data-tab="usage"
            data-content="{{ usage_val | escape }}">
            {{ 'doumdoum.products.productTabs.usage' | t }}
          </button>

          <button
            type="button"
            class="tab-btn"
            data-tab="ingredients"
            data-content="{{ ingredient_val |  escape }}">
            {{ 'doumdoum.products.productTabs.ingredients' | t }}
          </button>
        </div>
        <div class="tab-content-display" id="TabContentDisplay">
          {%- if details_val != blank -%}
            {{ details_val | escape | replace: '\n', '<br>' }}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  <div id="doumdoum__sticky-add-to-cart" class="sticky-add-to-cart is-visible">
    <div class="doumdoum__sticky-add-to-cart__container page-width">
      <div class="doumdoum__sticky-add-to-cart__info">
        <div class="doumdoum__sticky-add-to-cart__image">
          <img
            src="{{ product.featured_image |  image_url: width: product.featured_image.width  }}"
            width="{{ product.featured_image.width }}"
            height="{{ product.featured_image.height }}"
            alt="{{ product.featured_image.alt }}"
            loading="lazy">
        </div>
        <div class="doumdoum__sticky-add-to-cart_info-container">
          <div class="doumdoum__sticky-add-to-cart_info-container-title">
            <span class="doumdoum__sticky-add-to-cart__qty" id="sticky-qty-display">1x</span>
            <span class="doumdoum__sticky-add-to-cart__title">{{ product.title }}</span>
            {% if product.selected_or_first_available_variant.price %}
              <span class="doumdoum__sticky-add-to-cart__price">{{ product.selected_or_first_available_variant.price | money_without_trailing_zeros }}</span>
            {% endif %}
          </div>
          <div class="doumdoum__sticky-add-to-cart_info-container-reviews">
            {% render 'hero-yellow-stars' %}
            <span>
              {{ section.settings.review_text_add_to_cart }}
            </span>
          </div>
        </div>
      </div>

      <div class="doumdoum__sticky-add-to-cart__actions">
        {% if product.available %}
          <form
            action="/cart/add"
            method="post"
            enctype="multipart/form-data"
            class="sticky-form">
            <input
              type="hidden"
              name="id"
              value="{{ product.selected_or_first_available_variant.id }}">
            <input
              type="hidden"
              name="quantity"
              id="StickyQuantity-{{ section.id }}"
              value="1">
            <button
              type="button"
              id="sticky-buy-now-btn"
              class="doumdoum__add-btn doumdoum__sticky-btn-buy">
              <span class="btn-text--desktop">{{ 'doumdoum.products.productTabs.buyNowDesktop' | t }}</span>
              <span class="btn-text--mobile">{{ 'doumdoum.products.productTabs.buyNowMobile' | t }}</span>

            </button>
            <button
              type="submit"
              name="add"
              class="doumdoum__add-btn doumdoum__sticky-btn-cart light_ray">
              {{ 'doumdoum.products.productTabs.addToCart' | t }}
              <span id="sticky-cart-price-display" data-base-price="{{ product.selected_or_first_available_variant.price }}">
                {{ product.selected_or_first_available_variant.price | money_without_trailing_zeros }}
              </span>
            </button>
          </form>
          <p>{{ 'doumdoum.products.productTabs.protect30s' | t }}</p>
        {% else %}
          <button class="doumdoum__add-btn sticky-btn-disabled" disabled>{{ 'doumdoum.products.productTabs.disabled' | t }}</button>
        {% endif %}
      </div>

    </div>
  </div>
  <!-- Lightbox -->
  <div
    class="product-lightbox"
    id="ProductLightbox-{{ section.id }}"
    aria-hidden="true">

    <button
      type="button"
      class="product-lightbox-close"
      aria-label="Fermer">
      &times;
    </button>

    <div class="product-lightbox-content">
      <img
        id="LightboxImage-{{ section.id }}"
        src=""
        alt="">
    </div>

  </div>
</div>
</section>

{% schema %}
  {
    "name": "Product Section",
    "settings": [
      {
        "type": "text",
        "id": "review_text",
        "label": "Review Text",
        "default": "+5,000 maman a validé le produit"
      }, {
        "type": "text",
        "id": "review_text_add_to_cart",
        "label": "Review Text",
        "default": "+5 000 mamans, débutantes et expérimentées"
      }, {
        "type": "image_picker",
        "id": "approved",
        "label": "Approved"
      }
    ],
    "presets": [
      {
        "name": "Product Section"
      }
    ]
  }
{% endschema %}