{{ "doumdoum__nos-coffrets.css" | asset_url | stylesheet_tag }}

<section class="doumdoum__nos-coffrets page-width">
  <div class="doumdoum__nos-coffrets-label">
    <span>
      {{ section.settings.section_label }}
    </span>
  </div>
  <div class="doumdoum__nos-coffrets-heading">
    <h2>
      {{ section.settings.heading }}
    </h2>
  </div>
  <div class="doumdoum__nos-coffrets-products">
    <ul>

      {%- assign product_price = section.settings.first_product.price | money_without_trailing_zeros  | downcase -%}
      {%- assign add_to_cart_text = "Ajouter - " | append: product_price -%}

      {%- render 'doumdoum__big-product-card'
        , product: section.settings.first_product
        , product_image: section.settings.first_product_thumbnail
        , add_to_cart_text: add_to_cart_text
        , background_image: section.settings.product_bg -%}

      {%- assign product_price = section.settings.second_product.price | money_without_trailing_zeros  | downcase -%}
      {%- assign add_to_cart_text = "Ajouter - " | append: product_price -%}

      {%- render 'doumdoum__big-product-card'
        , product: section.settings.second_product
        , product_image: section.settings.second_product_thumbnail
        , add_to_cart_text: add_to_cart_text
        , background_image: section.settings.product_bg_2 -%}

      {%- assign product_price = section.settings.third_product.price | money_without_trailing_zeros  | downcase -%}
      {%- assign add_to_cart_text = "Ajouter - " | append: product_price -%}

      {%- render 'doumdoum__big-product-card'
        , product: section.settings.third_product
        , product_image: section.settings.third_product_thumbnail
        , add_to_cart_text: add_to_cart_text
        , background_image: section.settings.product_bg_3 -%}
    </ul>
  </div>
</section>

{% schema %}
  {
    "name": "Nos Coffrets",
    "tag": "section",
    "settings": [
      {
        "type": "text",
        "id": "section_label",
        "label": "Section Label",
        "default": "Nos Coffrets"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Coffrets bébé : confort et soin au quotidien"
      },
      {
        "type": "header",
        "content": "First Product"
      },
      {
        "type": "product",
        "id": "first_product",
        "label": "First Product"
      }, {
        "type": "image_picker",
        "id": "first_product_thumbnail",
        "label": "First Product Thumbnail"
      }, {
        "type": "color_background",
        "id": "first_background_color",
        "label": "First Background Color"
      }, {
        "type": "image_picker",
        "id": "product_bg",
        "label": "Product Background"
      }, {
        "type": "header",
        "content": "Second Product"
      }, {
        "type": "product",
        "id": "second_product",
        "label": "Second Product"
      }, {
        "type": "image_picker",
        "id": "second_product_thumbnail",
        "label": "Second Product Thumbnail"
      }, {
        "type": "color_background",
        "id": "second_background_color",
        "label": "Second Background Color"
      }, {
        "type": "image_picker",
        "id": "product_bg_2",
        "label": "Product Bg 2"
      }, {
        "type": "header",
        "content": "Third Product"
      }, {
        "type": "product",
        "id": "third_product",
        "label": "Third Product"
      }, {
        "type": "image_picker",
        "id": "third_product_thumbnail",
        "label": "Third Product Thumbnail"
      }, {
        "type": "color_background",
        "id": "third_background_color",
        "label": "Third Background Color"
      }, {
        "type": "image_picker",
        "id": "product_bg_3",
        "label": "Product Bg 3"
      }
    ],
    "presets": [
      {
        "name": "Nos Coffrets",
        "settings": {}
      }
    ]
  }
{% endschema %}