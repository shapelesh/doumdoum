{{ 'doumdoum__video-showcase.css' | asset_url | stylesheet_tag }}
<script src="{{ 'doumdoum__video-player.js' | asset_url }}" defer></script>
<script src="{{ 'video-overlay.js' | asset_url }}" defer></script>
{% comment %} <script type="module">
  import { CustomCartDrawer } from '{{ "custom-cart-drawer.js" | asset_url }}';
</script> {% endcomment %}
<section class="doumdoum__video-showcase page-width">


  <div class="doumdoum__video-showcase_header-container header-container ">
    <h3>{{ section.settings.header_title }}</h3>
    <a class="header-btn follow-link" href="{{ section.settings.follow_link }}">{{ section.settings.header_link }}
      <span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="23"
          height="23"
          viewBox="0 0 23 23"
          fill="none">
          <path
            d="M9.59766 7.30664L15.3205 7.30664L15.3205 13.0295"
            stroke="#F570B7"
            stroke-width="1.5"
            stroke-miterlimit="10"
            stroke-linecap="round"
            stroke-linejoin="round" />
          <path
            d="M7.30664 15.3203L15.2404 7.38658"
            stroke="#F570B7"
            stroke-width="1.5"
            stroke-miterlimit="10"
            stroke-linecap="round"
            stroke-linejoin="round" />
        </svg>
      </span>
    </a>
  </div>
  <div class="doumdoum__video-showcase_carousels-container glide" data-slider="video_carousel">
    <div class="glide__track" data-glide-el="track">
      <ul class="glide__slides">
        {% for block in section.blocks %}
          {% if block.type == 'videos' %}
            {% render 'custom-video'
              , block: block
              , video_index: forloop.index %}
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Video ShowCase",
    "settings": [
      {
        "type": "text",
        "id": "header_title",
        "label": "Titre des UGC",
        "default": "Les expériences réelles avec Doumdoum"
      }, {
        "type": "url",
        "id": "follow_link",
        "label": "Lien UGC"
      }, {
        "type": "text",
        "id": "header_link",
        "label": "Text boutton",
        "default": "Suivez-nous"
      }
    ],
    "blocks": [
      {
        "type": "videos",
        "name": "Videos",
        "settings": [
          {
            "type": "video",
            "id": "video_ugc",
            "label": "Video UGC"
          }, {
            "type": "text",
            "id": "product_handle",
            "label": "Handle du produit associé",
            "info": "Le handle (slug) du produit Shopify à afficher dans la modale vidéo, ex: mon-produit"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Video ShowCase"
      }
    ]
  }
{% endschema %}