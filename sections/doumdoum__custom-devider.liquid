{{ "doumdoum__custom-devider.css" | asset_url | stylesheet_tag }}

{%- liquid
  assign final_img_url = ''

  assign devider_data = product.metafields.custom.theme_devider_color.value

  if product and devider_data.devider_svg != blank
    assign final_img_url = devider_data.devider_svg.value | image_url: width: 800
  else
    if request.locale.iso_code == 'ar'
      assign final_img_url = 'devider-blue-ar.svg' | asset_url
    else
      assign final_img_url = 'devider-blue.svg' | asset_url
    endif
  endif
-%}
<section class="doumdoum__devider page-width section--{{ section.id }}">
  <div class="devider-svg-container">
    <img
      src="{{ final_img_url }}"
      alt="Devider"
      width="100%"
      height="100%"
      loading="lazy">
  </div>
</section>

{% schema %}
  {
    "name": "Custom Devider",
    "settings": [],
    "presets": [
      {
        "name": "Custom Devider"
      }
    ]
  }
{% endschema %}