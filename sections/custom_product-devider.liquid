<section class="doumdoum__devider section--{{ section.id }}">
  <div class="devider-svg-container">
    <img
      src="{{ 'devider-product.svg' | asset_url }}"
      alt="Devider"
      width="100%"
      height="100%"
      loading="lazy">
  </div>
</section>

<style>
  .doumdoum__devider {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }
  .devider-svg-container {
    width: 100%;
    height: 100%;
    display: flex;
  }
  .devider-svg-container svg {
    width: 100%;
    height: auto;
    display: block;
  }
  @media screen and (max-width: 450px) {
    .doumdoum__devider {
      overflow: hidden;
      width: 100%;
      height: 60px;
    }
    .devider-svg-container img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

  }
</style>
{% schema %}

  {
    "name": "Custom Devider - Product ",
    "settings": [],
    "presets": [
      {
        "name": "Custom Devider - Product"
      }
    ]
  }

{% endschema %}