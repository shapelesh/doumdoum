{{ 'doumdoum__about-product.css' | asset_url | stylesheet_tag }}

<section class="doumdoum__products-about page-width section--{{ section.id }}">
  <div class="doumdoum__products-about_carousel-container carousel-container" dir="ltr">
    {% assign target_collection = collections[section.settings.collection] %}
    {% for block in section.blocks %}
      {% if block.type == 'about_carousel' %}
        <div class="carousel-track" {{ block.shopify_attributes }}>

          {% if target_collection != blank %}
            {% for product in target_collection.products limit: section.settings.products_limit %}
              {%- render 'custom_about-carousel-slide'
                , product: product -%}
            {% endfor %}
          {% endif %}

        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
  {
    "name": "Carousel Produits About",
    "settings": [
      {
        "type": "collection",
        "id": "collection",
        "label": "Collection à afficher"
      }, {
        "type": "range",
        "id": "products_limit",
        "label": "Nombre de produits",
        "min": 1,
        "max": 50,
        "step": 1,
        "default": 10
      }
    ],
    "blocks": [
      {
        "type": "about_carousel",
        "name": "Zone Carousel",
        "limit": 1
      }
    ],
    "presets": [
      {
        "name": "Carousel Produits About",
        "blocks": [
          {
            "type": "about_carousel"
          }
        ]
      }
    ]
  }
{% endschema %}