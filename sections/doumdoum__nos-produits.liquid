<section class="doumdoum__nos-produits">
  <div class="doumdoum__nos-produits-top">
    <span>
      {{ section.settings.label }}
    </span>
    <h2>
      {{ section.settings.heading }}
    </h2>
  </div>
  <div class="doumdoum__nos-produits-products">
    <ul>
      {%- for product in section.settings.collection.products -%}
        <li>
          {{ product.title }}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
  {
    "name": "Nos Produits",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Découvrez nos produits pour bébé"
      }, {
        "type": "text",
        "id": "label",
        "label": "Label",
        "default": "Nos produits"
      }, {
        "type": "collection",
        "id": "collection",
        "label": "Collection"
      }
    ],
    "blocks": [
      {
        "name": "Product",
        "type": "product",
        "settings": [
          {
            "type": "product",
            "id": "product",
            "label": "Product"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Nos Produits",
        "settings": {}
      }
    ]
  }
{% endschema %}