{{ "doumdoum__nos-produits.css" | asset_url | stylesheet_tag }}


<section class="doumdoum__nos-produits">
  <div class="doumdoum__nos-produits-top">
    <span>
      {{ section.settings.label }}
    </span>
    <h2>
      {{ section.settings.heading }}
    </h2>
  </div>
  <div class="doumdoum__nos-produits-products">
    <ul>
      {%- for product in section.settings.collection.products -%}
        {%- render 'doumdoum__custom-product-card'
          , product: product
          , show_description: true -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
  {
    "name": "Nos Produits",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Découvrez nos produits pour bébé"
      }, {
        "type": "text",
        "id": "label",
        "label": "Label",
        "default": "Nos produits"
      }, {
        "type": "collection",
        "id": "collection",
        "label": "Collection"
      }
    ],
    "presets": [
      {
        "name": "Nos Produits",
        "settings": {}
      }
    ]
  }
{% endschema %}