{{ "doumdoum__nos-produits.css" | asset_url | stylesheet_tag }}


<section class="doumdoum__nos-produits page-width">
  <div class="doumdoum__nos-produits-top">
    <span>
      {{ section.settings.label }}
    </span>
    <h2>
      {{ section.settings.heading }}
    </h2>
  </div>
  {% liquid
    assign glide_class = ''

    if section.settings.mobile_layout == 'slider'
      assign glide_class = 'glide__slide'
    endif
  %}
  <div
    class="doumdoum__nos-produits-products {% if section.settings.mobile_layout == 'slider' %}is-slider{% endif %}" dir="{% if section.settings.mobile_layout == 'slider' %}ltr{% endif %}"
    {% if section.settings.mobile_layout == 'slider' %}
    data-slider="nosProduits"
    data-mobile-slider="992"
    {% endif %}>
    {% if section.settings.mobile_layout == 'slider' %}
      <div class="glide__track" data-glide-el="track">
    {% endif %}
    <ul
      {% if section.settings.mobile_layout == 'slider' %}
      class="glide__slides"
      {% endif %}>

      {%- for product in section.settings.collection.products -%}
        {%- render 'doumdoum__custom-product-card'
          , product: product
          , show_description: true
          , classname: glide_class -%}
      {%- endfor -%}
    </ul>
    {% if section.settings.mobile_layout == 'slider' %}
      <div class="glide__bullets" data-glide-el="controls[nav]">
    {% for product in section.settings.collection.products %}
      <button
        class="glide__bullet"
        data-glide-dir="={{ forloop.index0 }}">
      </button>
    {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
  {
    "name": "Nos Produits",
    "settings": [
      {
        "type": "select",
        "id": "mobile_layout",
        "label": "Affichage mobile",
        "default": "grid",
        "options": [
          {
            "value": "grid",
            "label": "Empilé"
          }, {
            "value": "slider",
            "label": "Slider"
          }
        ]
      }, {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Découvrez nos produits pour bébé"
      }, {
        "type": "text",
        "id": "label",
        "label": "Label",
        "default": "Nos produits"
      }, {
        "type": "collection",
        "id": "collection",
        "label": "Collection"
      }
    ],
    "presets": [
      {
        "name": "Nos Produits",
        "settings": {}
      }
    ]
  }
{% endschema %}