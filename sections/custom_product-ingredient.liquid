{% assign product_ingredients = product.metafields.custom.ingredients.value %}

<section class="doumdoum__custom-product-ingredient section-{{ section.id }} ingredient-of-{{ product.title }}">
  <div class="doumdoum__custom-product-ingredient_title product-ingredient_title">
    <h2>{{ section.settings.product_ingredient_title }}</h2>
  </div>
  {%- liquid
    assign devider_color = product.metafields.custom.devider_color | downcase

    if devider_color == 'blue'
      assign left_sun_img = 'pink-sun.svg' | asset_url
      assign right_sun_img = 'blue-sun.svg' | asset_url
    else
      assign left_sun_img = 'none'
      assign right_sun_img = 'pink-sun.svg' | asset_url
    endif
  -%}
  <div class="product-ingredient_container--sun-svg" style="--sun-left-url: {% if left_sun_img == 'none' %}none{% else %}url('{{ left_sun_img }}'){% endif %}; 
            --sun-right-url: url('{{ right_sun_img }}');">
    <div class="left-sun"></div>
    <div class="right-sun"></div>

  </div>
  <div class="doumdoum__custom-product-ingredient_container product-ingredient_container">

    {%- if product_ingredients -%}
      {%- for ingredient in product_ingredients -%}
        {%- render 'custom_ingredient-card'
          , ingredients: ingredient
          , loop_index: forloop.index -%}
      {%- endfor -%}
    {%- else -%}
      <p>Aucun ingrédient défini pour ce produit.</p>
    {%- endif -%}
  </div>
</section>
<style>
  .doumdoum__custom-product-ingredient {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 24px;
    padding: 57px;
  }
  .product-ingredient_container--sun-svg {
    position: absolute;
    top: 16%;
    left: 5%;
    width: 90%;
    height: 0;
    z-index: -1;
    pointer-events: none;
  }

  .left-sun::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 103.62px;
    height: 99px;
    background-image: var(--sun-left-url);
    background-size: contain;
    background-repeat: no-repeat;
    display: block;
    z-index: 0;
  }

  .right-sun::before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    width: 103.62px;
    height: 99px;
    background-image: var(--sun-right-url);
    background-size: contain;
    background-repeat: no-repeat;
    display: block;
    z-index: 0;
  }
  .product-ingredient_title {
    display: block;
    max-width: 300px;
  }
  .product-ingredient_title h2 {
    font-family: Fredoka;
    font-weight: 500;
    font-style: Medium;
    font-size: 26px;
    leading-trim: NONE;
    line-height: 120%;
    letter-spacing: -0.75%;
    text-align: center;
    margin: 0;
    color: #252B37;
  }
  .product-ingredient_container {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    justify-content: center;
    align-items: center;
    justify-self: center;
    column-gap: 16px;
    padding: 50px 0;
    row-gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .product-ingredient_container::-webkit-scrollbar {
    display: none;
    width: 0;
    background: transparent;
  }
  .ingredient-card {
    position: relative;
    justify-self: center;
    display: flex;
    flex-direction: row-reverse;
    justify-content: space-between;
    width: 280px;
    min-height: 200px;
    padding: 15px 12px;
    border-radius: 24px;
    border: none;
    outline: 1px solid #A4A7AE;
    overflow: hidden;
    background-color: #FAFAFA;
  }
  .ingredient-card__image-wrapper {
    width: 40%;
    display: flex;
    justify-content: flex-end;
    align-items: center;

  }
  .ingredient-card__image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .ingredient-card__image {
    position: absolute;
    top: 0;
    right: -31%;
    max-width: 100%;
    height: 174px;
    width: 94px;
  }

  .ingredient-card__content {
    width: 60%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: 12px;
  }
  .ingredient-card__content h3 {
    font-family: Fredoka;
    font-weight: 600;
    font-style: SemiBold;
    font-size: 20px;
    leading-trim: NONE;
    line-height: 120%;
    letter-spacing: -0.75%;
    color: #2998F6;
    margin: 0;
  }
  .ingredient-card__description {
    font-family: Nunito;
    font-weight: 500;
    font-style: Medium;
    font-size: 15px;
    leading-trim: NONE;
    line-height: 120%;
    letter-spacing: -0.5%;
    color: #414651;
    margin: 0;
  }
  .ingredient-card__benefits {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .ingredient-card__benefits li {
    position: relative;
    font-family: Nunito;
    font-weight: 500;
    font-style: Medium;
    font-size: 14px;
    leading-trim: NONE;
    line-height: 120%;
    letter-spacing: -0.5%;
    color: #414651;
    padding-left: 14px;
    margin: 0;
  }
  .ingredient-card__benefits li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 3px;
    width: 8px;
    height: 8px;
    background-color: #EF95C5;
    border-radius: 50%;
  }
  @media screen and (max-width: 768px) {
    .ingredient-card {
      width: 253px;
      min-height: 167px;
    }
    .ingredient-card__content h3 {
      font-size: 18px;
    }
    .doumdoum__custom-product-ingredient {
      padding: 57px 40px;
    }
    .product-ingredient_container--sun-svg {
      position: absolute;
      top: 18%;
      left: 5%;
      width: 90%;
      height: 0;
      z-index: -1;
      pointer-events: none;
    }
  }
  @media screen and (max-width: 450px) {
    .product-ingredient_container--sun-svg {
      position: absolute;
      top: 18%;
      left: -10%;
      width: 120%;
      height: 0;
      z-index: -1;
      pointer-events: none;
    }
    .ingredient-card__content h3 {
      font-size: 16px;
    }
    .doumdoum__custom-product-ingredient {
      padding: 57px 0 57px 16px;
      overflow: hidden;
    }
    .ingredient-card__description {
      font-size: 14px;
    }
    .ingredient-card__benefits li {
      font-size: 12px;
    }
  }
</style>
{% schema %}
  {
    "name": "Ingrédients Produit",
    "settings": [
      {
        "type": "text",
        "id": "product_ingredient_title",
        "label": "Titre de la section",
        "default": "Nos Ingrédients"
      }
    ],
    "presets": [
      {
        "name": "Ingrédients Produit"
      }
    ]
  }
{% endschema %}