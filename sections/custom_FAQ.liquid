<section class="doumdoum__custom-faq section--{{ section.id }}">
  <div class="doumdoum__custom-faq custom_faq--container">
    <h3>
      {{ section.settings.faq_title }}
    </h3>
    <div class="custom_faq--accordion">
      {% for block in section.blocks %}
        {% if block.type == 'custom_faq' %}
          {% render 'custom_faq-accordion'
            , block: block %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
<style>

  section.doumdoum__custom-faq {
    position: relative;
    display: flex;
    padding: 80px 0 153px;
  }
  .custom_faq--container {
    width: 100%;
    padding: 0 250px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  .custom_faq--container h3 {
    font-family: Fredoka;
    font-weight: 500;
    text-wrap: nowrap;
    font-style: Medium;
    font-size: 26px;
    leading-trim: NONE;
    line-height: 120%;
    letter-spacing: -0.75%;
    vertical-align: middle;
    text-align: center;
    padding: 0 450px 0 0;
    color: #181D27;

  }
  .custom_faq--accordion {
    width: 780px;
    border-radius: 16px;
    overflow: hidden;
    border: none;
    outline: 1px solid #D5D7DA;

    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* ##########Drop Down########### */

  .dropdown {
    width: 100%;
    padding: 16px;
    border-bottom: 1px solid #D5D7DA;

  }
  .dropdown-toggler {
    position: absolute;
    display: none;
  }
  .dropdown-container {
    transition: 650ms;
    display: grid;
    grid-template-rows: 1.5em 0;
  }
  .dropdown-title {
    cursor: pointer;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    align-content: center;
    user-select: none;
    position: relative;
    overflow: hidden;
    transition: 250ms;
    z-index: 2;
  }
  .dropdown-title h4 {
    font-family: Nunito;
    font-weight: 700;
    font-style: Bold;
    font-size: 18px;
    leading-trim: NONE;
    line-height: 120%;
    letter-spacing: -0.5%;
    vertical-align: middle;
    padding-left: 30px;
  }
  .dropdown-title__text {
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .dropdown-content__wrap {
    display: grid;
    grid-template-rows: 0;
    transition: grid-template-rows 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    overflow: hidden;
    padding-left: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
  }
  .dropdown-toggler:checked + .dropdown-container .dropdown-content__wrap {
    grid-template-rows: 1fr;
  }
  .dropdown-content {
    overflow: hidden;
    min-height: 0;
    padding-top: 10px;
    margin-top: 5px;
    min-height: 0;
    opacity: 0;
    transform: translateY(-10px);
    transition: opacity 0.8s ease
    , transform 0.9s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .dropdown-toggler:checked + .dropdown-container {
    grid-template-rows: 2.5em 1fr;
  }
  .dropdown-toggler:checked + .dropdown-container .dropdown-content__wrap .dropdown-content {
    opacity: 1;
    transform: translateY(0);
  }
  .dropdown._blurry .dropdown-content__wrap {
    transition: 650ms;
    transform-origin: bottom center;
  }

  /* ###### ICONS ###### */

  .dropdown._icon-plus .dropdown-title::after,
  .dropdown._icon-plus .dropdown-title::before {
    position: absolute;
    top: 0;
    left: 5px;
    bottom: 0;
    margin: auto;

  }
  /* + / - */
  .dropdown._icon-plus .dropdown-title::after,
  .dropdown._icon-plus .dropdown-title::before {
    content: "";
    font-size: 20px;
    border: solid 1px #F570B7;
    height: 12.01px;
    border-radius: 2px;
    transition: 650ms;
  }
  .dropdown._icon-plus .dropdown-title::after {
    transform: rotate(90deg);
  }
  .dropdown._icon-plus > .dropdown-toggler:checked + .dropdown-container > .dropdown-title::after {
    transform: rotate(90deg);
  }
  .dropdown._icon-plus > .dropdown-toggler:checked + .dropdown-container > .dropdown-title::before {
    transform: rotate(-90deg);
  }
  /* ###### CSS TRANSITION EFFECTS ###### */
  .dropdown._blurry .dropdown-content__wrap {
    transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0;
    transform-origin: bottom center;
  }
  .dropdown._blurry > .dropdown-toggler:checked + .dropdown-container > .dropdown-content__wrap {
    opacity: 1;
    transform: none;
  }
  @media screen and (max-width: 990px) {
    section.doumdoum__custom-faq {
      position: relative;
      display: flex;
      padding: 80px 90px 153px;
    }
    .custom_faq--container {
      width: 100%;
      padding: 0;
    }
    .custom_faq--accordion {
      width: 100%;
      margin: 0;
    }
    .custom_faq--container h3 {
      position: relative;
      padding: 0;
      align-self: baseline;
    }

  }
  @media screen and (max-width: 768px) {
    .dropdown-container {
      grid-template-rows: 2.5em 0;
    }
  }
  @media screen and (max-width: 620px) {
    section.doumdoum__custom-faq {
      position: relative;
      display: flex;
      padding: 80px 40px 153px;
    }

    .dropdown-title {
      overflow: visible;
    }

  }
  @media screen and (max-width: 450px) {
    section.doumdoum__custom-faq {
      position: relative;
      display: flex;
      padding: 80px 16px 153px;
    }
    .custom_faq--container h3 {
      font-family: Fredoka;
      font-weight: 600;
      font-style: SemiBold;
      font-size: 20px;
    }
    .dropdown-title h4 {
      font-family: Nunito;
      font-weight: 700;
      font-style: Bold;
      font-size: 16px;
      leading-trim: NONE;
      line-height: 120%;
      letter-spacing: -0.5%;
      vertical-align: middle;
    }

  }
</style>
{% schema %}
  {
    "name": "Custom FAQ",
    "settings": [
      {
        "type": "text",
        "id": "faq_title",
        "label": "Titre de Question frequentes",
        "default": "Questions fréquentes des parents"
      }
    ],
    "blocks": [
      {
        "type": "custom_faq",
        "name": "FAQ",
        "settings": [
          {
            "type": "text",
            "id": "faq_qst_text",
            "label": "Question"
          }, {
            "type": "text",
            "id": "faq_res_text",
            "label": "Réponse"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Custom FAQ",
        "blocks": [
          {
            "type": "custom_faq"
          }
        ]
      }
    ]
  }
{% endschema %}