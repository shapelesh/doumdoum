<section class="doumdoum__devider section--{{ section.id }}">

  <div class="devider-svg-container">
    {% if section.settings.color == 'rose' %}
      <img
        src="{{ 'devider-pink.svg' | asset_url }}"
        alt="Devider Rose"
        width="100%"
        height="100%"
        loading="lazy">
    {% elsif section.settings.color == 'bleu' %}
      <img
        src="{{ 'devider-blue.svg' | asset_url }}"
        alt="Devider Bleu"
        width="100%"
        height="100%"
        loading="lazy">
    {% elsif section.settings.color == 'vert' %}
      <img
        src="{{ 'devider-green.svg' | asset_url }}"
        alt="Devider Vert"
        width="100%"
        height="100%"
        loading="lazy">
    {% elsif section.settings.color == 'jaune' %}
      <img
        src="{{ 'devider-yellow.svg' | asset_url }}"
        alt="Devider Jaune"
        width="100%"
        height="100%"
        loading="lazy">
    {% elsif section.settings.color == 'cyan' %}
      <img
        src="{{ 'devider-cyan.svg' | asset_url }}"
        alt="Devider Cyan"
        width="100%"
        height="100%"
        loading="lazy">
    {% elsif section.settings.color == 'blanc' %}
      <img
        src="{{ 'devider-white.svg' | asset_url }}"
        alt="Devider Blanc"
        width="100%"
        height="100%"
        loading="lazy">
    {% elsif section.settings.color == 'orange' %}
      <img
        src="{{ 'devider-orang.svg' | asset_url }}"
        alt="Devider Orange"
        width="100%"
        height="100%"
        loading="lazy">
    {% elsif section.settings.color == 'violet' %}
      <img
        src="{{ 'devider-purple.svg' | asset_url }}"
        alt="Devider Violet"
        width="100%"
        height="100%"
        loading="lazy">
    {% endif %}
  </div>
</section>

<style>
  .doumdoum__devider {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }
  .devider-svg-container {
    width: 100%;
    height: 100%;
    display: flex;
  }
  .devider-svg-container svg {
    width: 100%;
    height: auto;
    display: block;
  }
  @media screen and (max-width: 450px) {
    .doumdoum__devider {
      overflow: hidden;
      width: 100%;
      height: 60px;
    }

  }
</style>
{% schema %}

  {
    "name": "Custom Devider ",
    "settings": [
      {
        "type": "select",
        "id": "color",
        "label": "Couleur du devider",
        "options": [
          {
            "value": "cyan",
            "label": "cyan"
          },
          {
            "value": "bleu",
            "label": "Bleu"
          },
          {
            "value": "vert",
            "label": "Vert"
          },
          {
            "value": "jaune",
            "label": "Jaune"
          }, {
            "value": "blanc",
            "label": "Blanc"
          }, {
            "value": "orange",
            "label": "Orange"
          }, {
            "value": "violet",
            "label": "Violet"
          }, {
            "value": "rose",
            "label": "Rose"
          }
        ],
        "default": "bleu"
      }
    ],
    "presets": [
      {
        "name": "Custom Devider"
      }
    ]
  }

{% endschema %}