<section class="doumdoum__devider section--{{ section.id }}">

  <div class="devider-svg-container">

    {% if section.settings.color == 'rose' %}
      {{ 'devider-pink.svg' | inline_asset_content }}
    {% elsif section.settings.color == 'bleu' %}
      {{ 'devider-blue.svg' | inline_asset_content }}
    {% elsif section.settings.color == 'vert' %}
      {{ 'devider-green.svg' | inline_asset_content }}
    {% elsif section.settings.color == 'jaune' %}
      {{ 'devider-yellow.svg' | inline_asset_content }}
    {% elsif section.settings.color == 'cyan' %}
      {{ 'devider-cyan.svg' | inline_asset_content }}
    {% elsif section.settings.color == 'blanc' %}
      {{ 'devider-white.svg' | inline_asset_content }}
    {% elsif section.settings.color == 'orange' %}
      {{ 'devider-orang.svg' | inline_asset_content }}
    {% elsif section.settings.color == 'violet' %}
    {% endif %}

  </div>
</section>

<style>
  .doumdoum__devider {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }
  .devider-svg-container {
    width: 100%;
    height: 100%;
    display: flex;
  }
  .devider-svg-container svg {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
{% schema %}

  {
    "name": "Custom Devider ",
    "settings": [
      {
        "type": "select",
        "id": "color",
        "label": "Couleur du devider",
        "options": [
          {
            "value": "cyan",
            "label": "cyan"
          },
          {
            "value": "bleu",
            "label": "Bleu"
          },
          {
            "value": "vert",
            "label": "Vert"
          },
          {
            "value": "jaune",
            "label": "Jaune"
          }, {
            "value": "blanc",
            "label": "Blanc"
          }, {
            "value": "orange",
            "label": "Orange"
          }, {
            "value": "violet",
            "label": "Violet"
          }, {
            "value": "rose",
            "label": "Rose"
          }
        ],
        "default": "bleu"
      }
    ],
    "presets": [
      {
        "name": "Custom Devider"
      }
    ]
  }

{% endschema %}