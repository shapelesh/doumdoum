{% assign product_ingredients = product.metafields.custom.ingredients.value %}

<section class="page-width doumdoum__product-ingredients section-{{ section.id }} ingredient-of-{{ product.title }}">
  <div class="doumdoum__product-ingredients_title product-ingredient_title">
    <h2>{{ section.settings.product_ingredient_title }}</h2>
  </div>
  <div class="product-ingredient_container--sun-svg">
    <div class="product-ingredient_container--sun-svg-left">
      <img
        src="{{ section.settings.left_sun |  image_url: width: section.settings.left_sun.width }}"
        alt="{{ section.settings.left_sun.alt }}"
        width="{{ section.settings.left_sun.width }}"
        height="{{ section.settings.left_sun.height }}">
    </div>
    <div class="product-ingredient_container--sun-svg-right">
      <img
        src="{{ section.settings.right_sun |  image_url: width: section.settings.right_sun.width }}"
        alt="{{ section.settings.right_sun.alt }}"
        width="{{ section.settings.right_sun.width }}"
        height="{{ section.settings.right_sun.height }}">
    </div>

  </div>
  <div class="doumdoum__product-ingredients_container product-ingredient_container">
    {%- if product_ingredients -%}
      <div class="glide" data-slider="ingredients">
        <div class="glide__track" data-glide-el="track">
          <ul class="glide__slides">
            {%- assign ingredient_1 = '' -%}
            {% for ingredient in product_ingredients %}
              {% assign remainder = forloop.index | modulo: 2 %}
              {% if remainder != 0 %}
                {%- capture ingredient_1 -%}
              {%- render 'custom_ingredient-card'
              , ingredients: ingredient
              , loop_index: forloop.index -%}
            {%- endcapture -%}
              {% else %}
                <li class="glide__slide">
                  <div class="doumdoum__product-ingredients-column">
                    {{ ingredient_1 }}
                    {%- render 'custom_ingredient-card'
                      , ingredients: ingredient
                      , loop_index: forloop.index -%}
                  </div>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>
      </div>
    {%- else -%}
      <p>{{ 'doumdoum.products.ingredient.fallBack' | t }}</p>
    {%- endif -%}
  </div>
</section>
<style>
  .doumdoum__product-ingredients {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 24px;
    padding: 57px;
    background-color: #fafafa;
  }
  .product-ingredient_container--sun-svg {
    position: relative;
    width: 100%;
    left: 0;
    right: 0;
  }
  .product-ingredient_container--sun-svg-left {
    width: 103px;
    height: 99px;
    position: absolute;
    left: 0;
    top: -30px;
  }
  .product-ingredient_container--sun-svg-left img {
    width: 100%;
    height: 100%;
  }
  .product-ingredient_container--sun-svg-right {
    width: 103px;
    height: 99px;
    position: absolute;
    right: 0;
    top: -30px;
  }
  .product-ingredient_container--sun-svg-right img {
    width: 100%;
    height: 100%;
  }
  .product-ingredient_title {
    display: block;
    max-width: 300px;
  }
  .product-ingredient_title h2 {
    font-family: Fredoka;
    font-weight: 500;
    font-style: Medium;
    font-size: 26px;
    leading-trim: NONE;
    line-height: 120%;
    letter-spacing: -0.75%;
    text-align: center;
    margin: 0;
    color: #252B37;
  }
  .product-ingredient_container {
    display: flex;
    width: 100%;
  }
  .product-ingredient_container .doumdoum__product-ingredients-column {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 2px;
  }
  .product-ingredient_container::-webkit-scrollbar {
    display: none;
    width: 0;
    background: transparent;
  }
  .ingredient-card {
    position: relative;
    justify-self: center;
    display: flex;
    min-height: 173px;
    padding: 15px 12px;
    border-radius: 24px;
    border: none;
    outline: 1px solid #A4A7AE;
    overflow: hidden;
    background-color: #FAFAFA;
  }
  .ingredient-card__image-wrapper {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
  }
  .ingredient-card__image-wrapper img {
    height: 100%;
    object-fit: cover;
  }
  .ingredient-card__image {
    max-width: 100%;
    height: 174px;
    width: 94px;
  }

  .ingredient-card__content {
    width: 80%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: 12px;
    z-index: 2;
  }
  .ingredient-card__content h3 {
    font-family: Fredoka;
    font-weight: 600;
    font-style: SemiBold;
    font-size: 20px;
    leading-trim: NONE;
    line-height: 120%;
    letter-spacing: -0.75%;
    color: #2998F6;
    margin: 0;
  }
  .ingredient-card__description {
    font-family: Nunito;
    font-weight: 500;
    font-style: Medium;
    font-size: 15px;
    leading-trim: NONE;
    line-height: 120%;
    letter-spacing: -0.5%;
    color: #414651;
    margin: 0;
  }
  .ingredient-card__benefits {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .ingredient-card__benefits li {
    position: relative;
    font-family: Nunito;
    font-weight: 500;
    font-style: Medium;
    font-size: 14px;
    leading-trim: NONE;
    line-height: 120%;
    letter-spacing: -0.5%;
    color: #414651;
    padding-left: 14px;
    margin: 0;
    text-wrap: nowrap;
  }
  .ingredient-card__benefits li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 3px;
    width: 8px;
    height: 8px;
    background-color: #EF95C5;
    border-radius: 50%;
  }
  @media screen and (max-width: 768px) {
    .ingredient-card__content h3 {
      font-size: 18px;
    }
    .doumdoum__product-ingredients {
      padding: 57px 40px;
    }
  }
  @media screen and (max-width: 600px) {
    .doumdoum__product-ingredients {
      padding: 54px 16px;
    }

    .product-ingredient_container--sun-svg-left {
      left: -56px;
    }
  }
  @media screen and (max-width: 450px) {
    .ingredient-card__content h3 {
      font-size: 16px;
    }
    .doumdoum__product-ingredients {
      padding: 57px 0 57px 16px;
      overflow: hidden;
    }
    .ingredient-card__description {
      font-size: 14px;
    }
    .ingredient-card__benefits li {
      font-size: 12px;
    }
  }
</style>
{% schema %}
  {
    "name": "Product ingredients",
    "settings": [
      {
        "type": "text",
        "id": "product_ingredient_title",
        "label": "Titre de la section",
        "default": "Nos Ingrédients"
      }, {
        "type": "image_picker",
        "id": "left_sun",
        "label": "Left Sun"
      }, {
        "type": "image_picker",
        "id": "right_sun",
        "label": "Right Sun"
      }
    ],
    "presets": [
      {
        "name": "Product ingredients"
      }
    ]
  }
{% endschema %}