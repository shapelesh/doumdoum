{{ "doumdoum__testimonials.css" | asset_url | stylesheet_tag }}

<section class="doumdoum__testimonials page-width">
  <div class="doumdoum__testimonials-top">
    <div class="doumdoum__testimonials-label">
      <span>
        {{ section.settings.label }}
      </span>
    </div>
    <h2>
      {{ section.settings.heading }}
    </h2>
  </div>

  {%- if section.settings.top_image != blank -%}
    <div class="doumdoum__testimonials-image">
      <img
        src="{{ section.settings.top_image | image_url: width: section.settings.top_image.width }}"
        alt="{{ section.settings.top_image.alt }}"
        width="{{ section.settings.top_image.width }}"
        height="{{ section.settings.top_image.height }}"
        loading="lazy">
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="doumdoum__testimonials-cards">
      <div class="glide" data-slider="testimonials">
        <div class="glide__track" data-glide-el="track">
          <ul class="glide__slides">
            {%- for block in section.blocks -%}
              <li
                class="glide__slide"
                {% if block.settings.background != blank %}
                style="background-color: {{ block.settings.background }};"
                {% endif %}
                {{ block.shopify_attributes }}>
                <div class="doumdoum__testimonial-card">
                  <div class="doumdoum__testimonials-card-top">
                    <p class="doumdoum__testimonial-card-author">
                      {{ block.settings.author }}
                    </p>
                  </div>
                  <div class="doumdoum__testimonials-card">
                    <p class="doumdoum__testimonial-card-text">
                      {{ block.settings.text }}
                    </p>
                  </div>
                </div>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>

    </div>
  {%- endif -%}
</section>

{% schema %}
  {
    "name": "Testimonials",
    "tag": "section",
    "settings": [
      {
        "type": "text",
        "id": "label",
        "label": "Label",
        "default": "Témoignages"
      }, {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Aimé par +10,000 parents"
      }, {
        "type": "checkbox",
        "id": "show_stars",
        "label": "Show stars",
        "default": true
      }, {
        "type": "image_picker",
        "id": "top_image",
        "label": "Top Image",
        "info": "Photo collage shown under the heading."
      }
    ],
    "blocks": [
      {
        "name": "Testimonial",
        "type": "testimonial",
        "settings": [
          {
            "type": "textarea",
            "id": "text",
            "label": "Testimonial",
            "default": "Franchement, je n'attendais pas un résultat aussi rapide. La peau de mon bébé est plus douce dès la première semaine."
          }, {
            "type": "text",
            "id": "author",
            "label": "Author",
            "default": "Une maman"
          }, {
            "type": "color",
            "id": "background",
            "label": "Background color",
            "info": "Optional. Leave empty to alternate blue/pink automatically."
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Testimonials",
        "blocks": [
          {
            "type": "testimonial"
          },
          {
            "type": "testimonial"
          },
          {
            "type": "testimonial"
          },
          {
            "type": "testimonial"
          }, {
            "type": "testimonial"
          }, {
            "type": "testimonial"
          }
        ]
      }
    ]
  }
{% endschema %}