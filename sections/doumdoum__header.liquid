{{ 'doumdoum__header.css' | asset_url | stylesheet_tag }}

<section class="doumdoum__header page-width">
  <div class="doumdoum__header-left">
    <div class="doumdoum__header-left-desktop">
      <span class="header-link {% if request.page_type == 'index' %}active{% endif %}">
        <a href="{{ shop.url }}">
          Accueil
        </a>
      </span>
      <span
        class="header-link"
        id="megamenu_opener"
        aria-expanded="false">
        <span>
          Boutique
        </span>
        {% render 'icon-down-caret' %}
      </span>
      {%- for link in section.settings.menu.links -%}
        <span class="header-link {% if link.current %}active{% endif %}">
          <a href="{{ link.url }}">
            {{ link.title }}
          </a>
        </span>
      {%- endfor -%}
    </div>
    <div class="doumdoum__header-left-mobile">
      {% render 'doumdoum__header-drawer-opener' %}
    </div>
    {%- render 'custom-header-megamenu'
      , section: section -%}
  </div>

  <div class="doumdoum__header-center">

    {% render 'custom-logo'
      , image: section.settings.logo
      , image_mobile: nil
      , width: 280
    %}
  </div>
  <div class="doumdoum__header-bottom">

    {% render 'header-actions'
      , customer_account_menu: section.settings.customer_account_menu
      , display_style: "icon"
      , section: section %}
  </div>
</section>
{%- render 'custom-header-drawer'
  , section: section -%}
<script
  src="{{ 'custom-header-menu.js' | asset_url }}"
  type="module"
  fetchpriority="low"
  defer></script>
<style></style>
{% schema %}
  {
    "name": "doumdoum header",
    "settings": [
      {
        "type": "link_list",
        "id": "menu",
        "label": "Menu"
      }, {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      }, {
        "type": "link_list",
        "id": "customer_account_menu",
        "label": "t:settings.menu",
        "default": "customer-account-main-menu"
      }
    ],
    "blocks": [
      {
        "type": "megamenu_tab",
        "name": "Megamenu Tab",
        "settings": [
          {
            "type": "text",
            "id": "tab_name",
            "label": "Tab Name"
          }, {
            "type": "collection",
            "id": "collection",
            "label": "Collection"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "doumdoum header",
        "settings": {}
      }
    ]
  }
{% endschema %}