{{ 'video-player.js' | asset_url | script_tag }}
{{ 'cart-drawer.js' | asset_url | script_tag }}
<section class="doumdoum__video-showcase">


  <div class="doumdoum__video-showcase_header-container header-container">
    <h3>{{ section.settings.header_title }}</h3>
    <a class="header-btn follow-link" href="{{ section.settings.follow_link }}">{{ section.settings.header_link }}
      <span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="23"
          height="23"
          viewBox="0 0 23 23"
          fill="none">
          <path
            d="M9.59766 7.30664L15.3205 7.30664L15.3205 13.0295"
            stroke="#F570B7"
            stroke-width="1.5"
            stroke-miterlimit="10"
            stroke-linecap="round"
            stroke-linejoin="round" />
          <path
            d="M7.30664 15.3203L15.2404 7.38658"
            stroke="#F570B7"
            stroke-width="1.5"
            stroke-miterlimit="10"
            stroke-linecap="round"
            stroke-linejoin="round" />
        </svg>
      </span>
    </a>
  </div>
  <div class="doumdoum__video-showcase_carousels-container">
    <ul class="carousel-vids">
      {% for block in section.blocks %}
        {% if block.type == 'videos' %}
          {% render 'custom-video'
            , block: block 
 video_index: forloop.index %}
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</section>
<style>


  .doumdoum__video-showcase {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 24px;
    padding: 100px 107px;
  }
  .header-container {
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    padding: 14.5px 16px;

  }
  .header-container h3 {
    font-family: Fredoka;
    font-weight: 500;
    font-style: Medium;
    font-size: 26px;
    leading-trim: NONE;
    line-height: 120%;
    letter-spacing: -0.75%;
    text-align: center;
    vertical-align: middle;
    color: #252B37;
    margin: 0;

  }
  .header-container a {
    display: flex;
    font-family: Geist;
    font-weight: 500;
    font-style: Medium;
    font-size: 16px;
    leading-trim: NONE;
    line-height: 120%;
    letter-spacing: -0.5%;
    border-radius: 16px;
    padding: 8.5px 16px;
    border: none;
    outline: 1px solid #E9EAEB;
    color: #F570B7;
  }
  .doumdoum__video-showcase_carousels-container {
    width: 100%;
    height: 100%;
    overflow: auto;
  }
  .carousel-vids {
    width: max-content;
    height: 100%;
    display: flex;
    flex-direction: row;
    gap: 10px;
    padding: 16px;

    overflow-x: auto;
    overflow-y: hidden;


    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }
  .carousel-vids::-webkit-scrollbar {
    display: none;
  }
  .carousel-vids li {
    list-style: none;
    margin: 0;
    flex-shrink: 0;
  }
  .video-ugc {
    width: 200px;
    height: 360px;
  }

  @media screen and (max-width: 990px) {
    .doumdoum__video-showcase {
      padding: 100px 90px;
    }

  }
  @media screen and (max-width: 768px) {
    .doumdoum__video-showcase {
      padding: 100px 90px;
    }
    .header-container h3 {

      text-align: left;
    }
    .header-container a {
      text-wrap: nowrap;
      align-self: center;
    }
  }
  @media screen and (max-width: 620px) {
    .doumdoum__video-showcase {
      padding: 100px 40px;
    }
    .header-container h3 {
      font-size: 22px;

    }
  }
  @media screen and (max-width: 450px) {
    .doumdoum__video-showcase {
      padding: 86px 16px;
    }
    .header-container {
      padding: 0;

    }
    .header-container h3 {
      font-size: 17px;
    }
    .header-container a {
      font-size: 15px;
    }
    .doumdoum__video-showcase_carousels-container,
    .carousel-vids {
      padding: 0;
    }
  }
</style>
{% schema %}
  {
    "name": "Video ShowCase",
    "settings": [
      {
        "type": "text",
        "id": "header_title",
        "label": "Titre des UGC",
        "default": "Les expériences réelles avec Doumdoum"
      }, {
        "type": "url",
        "id": "follow_link",
        "label": "Lien UGC"
      }, {
        "type": "text",
        "id": "header_link",
        "label": "Text boutton",
        "default": "Suivez-nous"
      }
    ],
    "blocks": [
      {
        "type": "videos",
        "name": "Videos",
        "settings": [

          {
            "type": "video",
            "id": "video_ugc",
            "label": "Video UGC"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Video ShowCase"
      }
    ]
  }
{% endschema %}