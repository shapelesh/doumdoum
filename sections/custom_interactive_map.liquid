<!-- Chargement local des assets Leaflet depuis le dossier Assets de Shopify -->
{{ 'leaflet.css' | asset_url | stylesheet_tag }}
<script src="{{ 'leaflet.js' | asset_url }}" defer="defer"></script>

<section class="doumdoum__map section--{{ section.id }}">
  <div class="doumdoum__map-container map-container">

    <div class="map-container-prameters">
      <div class="param_title">
        <h3>{{ section.settings.param_title }}</h3>
        <p>{{ section.settings.param_info }}</p>
      </div>

      <div class="param_map">
        {% for block in section.blocks %}
          {% if block.type == 'wilaya' %}
            <button
              class="btn-wilaya"
              data-wilaya-id="{{ block.id }}"
              data-center="{{ block.settings.center_lat }},{{ block.settings.center_lon }}"
              data-zoom="{{ block.settings.zoom_level }}">
              <div class="pine-icon-svg">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="20"
                  viewBox="0 0 16 20"
                  fill="none">
                  <path d="M8.00008 3.69238C5.61854 3.69238 3.69238 5.61854 3.69238 8.00008C3.69238 11.2308 8.00008 16.0001 8.00008 16.0001C8.00008 16.0001 12.3078 11.2308 12.3078 8.00008C12.3078 5.61854 10.3816 3.69238 8.00008 3.69238ZM8.00008 9.53854C7.59205 9.53854 7.20074 9.37645 6.91222 9.08793C6.6237 8.79941 6.46161 8.4081 6.46161 8.00008C6.46161 7.59205 6.6237 7.20074 6.91222 6.91222C7.20074 6.6237 7.59205 6.46161 8.00008 6.46161C8.4081 6.46161 8.79941 6.6237 9.08793 6.91222C9.37645 7.20074 9.53854 7.59205 9.53854 8.00008C9.53854 8.4081 9.37645 8.79941 9.08793 9.08793C8.79941 9.37645 8.4081 9.53854 8.00008 9.53854Z" fill="#FF5246" />
                </svg>
              </div>
              <p>
                {{ block.settings.wilaya_name }} ({{ block.settings.pin_number }})
              </p>

              <div class="arrow-right-icon-svg">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="6"
                  height="12"
                  viewBox="0 0 6 12"
                  fill="none">
                  <path
                    d="M0.5 11.06L4.84667 6.71333C5.36 6.2 5.36 5.36 4.84667 4.84667L0.5 0.5"
                    stroke="#353535"
                    stroke-miterlimit="10"
                    stroke-linecap="round"
                    stroke-linejoin="round" />
                </svg>
              </div>
            </button>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="map-container--map" id="map-{{ section.id }}"></div>

  </div>
</section>

<style>
  .doumdoum__map {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 100px 112px;
  }
  .map-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .map-container-prameters {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .param_title {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .param_title h3 {
    font-family: 'Fredoka'
    , sans-serif;
    font-weight: 600;
    font-style: normal;
    font-size: 20px;
    line-height: 120%;
    letter-spacing: -0.0075em;
    margin: 0;
  }
  .param_title p {
    font-family: 'Inter'
    , sans-serif;
    font-weight: 400;
    font-style: normal;
    font-size: 15px;
    line-height: 120%;
    letter-spacing: -0.005em;
    margin: 0;
  }

  .param_map {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .btn-wilaya {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 10px;
    border-radius: 16px;
    border: 1px solid #D5D7DA;
    background-color: #ffffff;
    cursor: pointer;
    text-align: left;
    transition: background-color 0.2s ease;
  }
  .btn-wilaya:hover {
    background-color: #e0e0e0;
  }
  .btn-wilaya p {
    width: 149px;
    margin: 0;
    font-family: 'Nunito'
    , sans-serif;
    font-weight: 500;
    font-style: normal;
    font-size: 15px;
    line-height: 120%;
    letter-spacing: -0.005em;
    color: #535862;
  }
  .arrow-right-icon-svg {
    display: flex;
    align-items: center;
  }


  #map-{{ section.id }} {
    height: 500px;
    width: 100%;
    z-index: 1;
    background: #eee;
    border-radius: 8px;
  }

  .custom-div-icon {
    background: transparent;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 32px;
    height: 32px;
    color: #ffffff;
    text-align: center;
    font-weight: bold;
    font-size: 14px;
    border-radius: 50%;
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.4);
    font-family: sans-serif;
    cursor: pointer;
  }
  .map-pin {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .map-pin svg {
    position: relative;
    width: 100%;
    min-width: 44.24px;
    height: 100%;
    z-index: -1;
  }
  .map-pin p {
    position: absolute;
    top: 3px;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 4.09px;
    z-index: 2;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    color: black;
  }
  .map-pin p span {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 16.09px;
    height: 16.09px;
    border-radius: 50%;
    background-color: #EA4234;
  }
  .map-pin p span svg {
    z-index: 1;
  }

  @media (min-width: 768px) {
    .map-container {
      flex-direction: row;
      justify-content: space-between;
    }
    .map-container-prameters {
      width: 30%;
    }
    .map-container--map {
      width: 70%;
    }
    .btn-wilaya {
      justify-content: flex-start;
    }
  }


  @media (max-width: 768px) {
    #map-{{ section.id }} {
      height: 350px;

    }
  }
  @media (max-width: 620px) {
    .doumdoum__map {
      padding: 60px 40px;

    }
  }
  @media (max-width: 450px) {
    .doumdoum__map {
      padding: 40px 16px;
    }
  }
</style>

<script>
  (function() {
    const mapData = {};
    const wilayaIds = [];
  
    {% for block in section.blocks %}
      {% if block.type == 'wilaya' %}
        (function() {
          const currentWilayaId = "{{ block.id }}";
          wilayaIds.push(currentWilayaId);
          
          mapData[currentWilayaId] = {
            name: "{{ block.settings.wilaya_name | escape }}",
            pinNumber: {{ block.settings.pin_number | default: 1 }},
            center: [{{ block.settings.center_lat | default: 36.5 }}, {{ block.settings.center_lon | default: 3.0 }}],
            zoom: {{ block.settings.zoom_level | default: 10 }},
            gmapLink: "{{ block.settings.google_maps_link | default: '#' }}" 
          };
        })();
      {% endif %}
    {% endfor %}
  
    
    function initLeafletMap() {
    
      if (typeof L === 'undefined') {
        setTimeout(initLeafletMap, 100);
        return;
      }
  
      const mapElement = document.getElementById('map-{{ section.id }}');
      if (!mapElement) return;
  
      const map = L.map('map-{{ section.id }}').setView([36.5, 3.0], 6);
      
      L.tileLayer('https://{s}.tile.openstreetmap.fr/osmfr/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap'
      }).addTo(map);
  
      const markersGroup = L.layerGroup().addTo(map);
  
      function createNumberedIcon(number) {
        return L.divIcon({
          className: 'custom-div-icon',
          html: `<div class="map-pin"><svg xmlns="http://www.w3.org/2000/svg" width="46" height="30" viewBox="0 0 46 30" fill="none">
  <path d="M21.9901 28.6059C22.3448 29.1972 23.2072 29.181 23.5395 28.5768L27.1962 21.9282C27.5104 21.3571 28.1105 21.0022 28.7624 21.0022H34.4084C40.0846 21.0022 44.6861 16.4007 44.6861 10.7245C44.6861 5.04827 40.0846 0.446777 34.4084 0.446777H22.7901H10.725C5.04875 0.446777 0.447266 5.04827 0.447266 10.7245C0.447266 16.4007 5.04876 21.0022 10.725 21.0022H16.4158C17.0437 21.0022 17.6255 21.3316 17.9485 21.87L21.9901 28.6059Z" fill="white" stroke="#9AA0A6" stroke-width="0.893714"/>
  <p> <span><svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="20"
                  viewBox="0 0 16 20"
                  fill="none">
                  <path d="M8.00008 3.69238C5.61854 3.69238 3.69238 5.61854 3.69238 8.00008C3.69238 11.2308 8.00008 16.0001 8.00008 16.0001C8.00008 16.0001 12.3078 11.2308 12.3078 8.00008C12.3078 5.61854 10.3816 3.69238 8.00008 3.69238ZM8.00008 9.53854C7.59205 9.53854 7.20074 9.37645 6.91222 9.08793C6.6237 8.79941 6.46161 8.4081 6.46161 8.00008C6.46161 7.59205 6.6237 7.20074 6.91222 6.91222C7.20074 6.6237 7.59205 6.46161 8.00008 6.46161C8.4081 6.46161 8.79941 6.6237 9.08793 6.91222C9.37645 7.20074 9.53854 7.59205 9.53854 8.00008C9.53854 8.4081 9.37645 8.79941 9.08793 9.08793C8.79941 9.37645 8.4081 9.53854 8.00008 9.53854Z" fill="#FF5246" />
                </svg></span> ${number}</p>
  </svg></div>`,
          iconSize: [32, 32],
          iconAnchor: [16, 16]
        });
      }
  
    
      wilayaIds.forEach((id, index) => {
        const data = mapData[id];
        if (data) {
          const number = data.pinNumber;
          const icon = createNumberedIcon(number);
          
          const marker = L.marker(data.center, { icon: icon }).addTo(markersGroup);
    
          marker.on('click', () => {
            if (data.gmapLink && data.gmapLink !== '#') {
              window.open(data.gmapLink, '_blank');
            } else {
              marker.bindPopup(`<strong>${number}. ${data.name}</strong><br><em>Cliquez sur la liste pour recentrer</em>`).openPopup();
            }
          });
          
          marker.bindTooltip(`${number}. ${data.name}`, { direction: 'top' });
        }
      });
  
      document.querySelectorAll('.btn-wilaya').forEach(btn => {
        btn.addEventListener('click', () => {
          const wilayaId = btn.dataset.wilayaId;
          const data = mapData[wilayaId];
          if (!data) return;
    
          map.flyTo(data.center, data.zoom, { duration: 1.5 });
        });
      });
    }
  
    document.addEventListener('DOMContentLoaded', initLeafletMap);
  })();
</script>

{% schema %}
  {
    "name": "Custom Map",
    "settings": [
      {
        "type": "text",
        "id": "param_title",
        "label": "Titre des paramètres",
        "default": "Disponibles près de vous"
      }, {
        "type": "text",
        "id": "param_info",
        "label": "Info des paramètres",
        "default": "Nos produits sont présents dans des points de vente sélectionnés à travers le pays"
      }
    ],
    "blocks": [
      {
        "type": "wilaya",
        "name": "📍 Wilaya (Groupe)",
        "settings": [
          {
            "type": "text",
            "id": "wilaya_name",
            "label": "Nom Wilaya"
          },
          {
            "type": "number",
            "id": "center_lat",
            "label": "Latitude Centre",
            "info": "Ex: 36.75",
            "default": 36
          },
          {
            "type": "number",
            "id": "center_lon",
            "label": "Longitude Centre",
            "info": "Ex: 3.05",
            "default": 3
          },
          {
            "type": "range",
            "id": "zoom_level",
            "min": 5,
            "max": 18,
            "default": 12,
            "label": "Zoom"
          }, {
            "type": "number",
            "id": "pin_number",
            "label": "Numéro du Pin",
            "info": "Ex: 16 pour Alger, 31 pour Oran",
            "default": 1
          }, {
            "type": "url",
            "id": "google_maps_link",
            "label": "Lien Google Maps",
            "info": "Collez le lien Google Maps pour cette wilaya"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Carte des Stores",
        "blocks": [
          {
            "type": "wilaya"
          }
        ]
      }
    ]
  }
{% endschema %}