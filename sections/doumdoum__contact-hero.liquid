{{ 'doumdoum__contact-hero.css' | asset_url | stylesheet_tag }}

<section class="doumdoum__contact-hero page-width">
  <div class="doumdoum__contact-hero-bg">
    {% if section.settings.banner_type == 'video' and section.settings.contact_banner_video != blank %}

      {{ section.settings.contact_banner_video | video_tag: image_size: '1800x1000', autoplay: section.settings.video_autoplay, loop: true, muted: true, controls: false, class: 'hero-video' }}

    {% elsif section.settings.banner_type == 'image' and section.settings.contact_banner_img != blank %}

      <img
        src="{{ section.settings.contact_banner_img |  image_url: width: section.settings.contact_banner_img.width }}"
        width="{{ section.settings.contact_banner_img.width }}"
        height="{{ section.settings.contact_banner_img.height }}"
        alt="{{ section.settings.contact_banner_img.alt }}"
        loading="eager">

    {% endif %}

  </div>
  <div class="doumdoum__contact-hero-content">
    <h2>{{ section.settings.contact_title }}</h2>
    <div class="doumdoum__contact-hero-contact-card">
      <div class="contact-card-profile">
        <div class="contact-card-profile-picture">
          <img
            src="{{ section.settings.profile_picture |  image_url: width: section.settings.profile_picture.width  }}"
            width="{{ section.settings.profile_picture.width }}"
            height="{{ section.settings.profile_picture.height }}"
            alt="{{ section.settings.profile_picture.alt }}"
            loading="lazy">
        </div>
        <div class="contact-card-profile-info">
          <h1>{{ section.settings.profile_info_title }}</h1>
          <p>{{ section.settings.profile_info_sub_title }}</p>
        </div>
      </div>
      <div class="contact-card-btn">
        <a href="{{ section.settings.whatsapp_link }}" class="light_ray">
          {% liquid
            assign bg_btn = 'btn_bg_contact.png' | asset_url
          %}
          <div class="doumdoum_chat-icon" style="--bg-btn: url('{{ bg_btn }}')"></div>
          {{ section.settings.whatsapp_btn }}</a>
      </div>
      <p>Réponse en quelques minutes ...</p>
    </div>
  </div>
</section>
{% schema %}
  {
    "name": "Contact Hero",
    "settings": [
      {
        "type": "select",
        "id": "banner_type",
        "label": "Type de média",
        "options": [
          {
            "value": "image",
            "label": "Image"
          }, {
            "value": "video",
            "label": "Vidéo"
          }
        ],
        "default": "image"
      },
      {
        "type": "video",
        "id": "contact_banner_video",
        "label": "Bannière Vidéo"
      },
      {
        "type": "image_picker",
        "id": "contact_banner_img",
        "label": "Image d'arriere plan"
      },
      {
        "type": "text",
        "id": "contact_title",
        "label": "Titre Contact",
        "default": "Dis Salut !"
      }, {
        "type": "image_picker",
        "id": "profile_picture",
        "label": "Photo de profile"
      }, {
        "type": "text",
        "id": "profile_info_title",
        "label": "Nom de DoumDoum",
        "info": "Important pour le SEO !",
        "default": "Doumdoum.babycare"
      }, {
        "type": "text",
        "id": "profile_info_sub_title",
        "label": "Text du profile",
        "default": "Salut, je suis Younes. Parlons !"
      }, {
        "type": "url",
        "id": "whatsapp_link",
        "label": "Lien whats'app"
      }, {
        "type": "text",
        "id": "whatsapp_btn",
        "label": "Boutton chat",
        "default": "CHATTER MAINTENANT"
      }
    ],
    "presets": [
      {
        "name": "Contact Hero"
      }
    ]
  }
{% endschema %}