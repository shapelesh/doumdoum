<li class="glide__slide video-ugc block--{{ block.id }}" id="video--{{ video_index }}">
  {% if block.settings.video_ugc != blank %}
    {% assign video_obj = block.settings.video_ugc %}

    {% if video_obj.sources %}
      {% assign mp4_source = video_obj.sources | where: 'format', 'mp4' | first %}
      {% assign video_src = mp4_source.url | default: video_obj.sources.first.url %}
    {% else %}
      {% assign video_src = video_obj %}
    {% endif %}

    <doumdoum-video-player
      data-video-url="{{ video_src }}"
      data-cover-image="{{ video_obj.preview_image | image_url: width: 600 }}"
      data-product-handle="{{ block.settings.product_handle | default: '' }}"
      style="display: block; width: 100%; height: 100%;"></doumdoum-video-player>

  {% else %}

    <div style="width: 100%; height: 100%; background: #e1e1e1; display: flex; align-items: center; justify-content: center; border-radius: 24px; color: #666;">
      Sélectionnez une vidéo
    </div>
  {% endif %}
</li>
