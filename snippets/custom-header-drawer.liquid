
<custom-header-drawer aria-hidden="true">
  <div id="doumdoum__header-drawer" class="doumdoum__custom-header-drawer" ref="headerDrawer" aria-hidden="true">
    <div class="doumdoum__header-drawer-top">
      {% render 'custom-logo'
        , image: section.settings.logo
        , image_mobile: nil
        , width: 188
      %}
      <span id="doumdoum__header-drawer-closer">
        {% render 'doumdoum__header-close-icon' %}
      </span>
    </div>
  </div>
</custom-header-drawer>

<style>
  custom-header-drawer {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    right: 0;
    z-index: 8;
    pointer-events: none;
  }

  custom-header-drawer.is-open {
    pointer-events: all;
    background-color: rgba(0, 0, 0, 0.5);
  }

  .doumdoum__custom-header-drawer {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 375px;
    max-width: 100%;
    background-color: #fff;
    transform: translateX(-100%);
    transition: transform 0.3s ease;
    overflow-y: auto;
    padding: 8px 16px;
  }

  custom-header-drawer.is-open .doumdoum__custom-header-drawer {
    transform: translateX(0);
  }

  .doumdoum__header-drawer-top {
    padding: 4.88px 8px 12.88px;
    border-bottom: 1px solid #D5D7DA;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .doumdoum__header-drawer-top #doumdoum__header-drawer-closer {
    cursor: pointer;
  }
  </style>