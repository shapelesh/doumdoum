{% assign block_settings = block.settings %}
{%- form 'customer'
  , class: 'custom_email-signup__form' %}
  <div class="custom__email-signup__input-group">
    <label for="EmailInput-{{ block.id }}" class="visually-hidden">
      {{ 'blocks.email_signup.label' | t }}
    </label>
    <input
      id="EmailInput-{{ block.id }}"
      class="custom__email-signup__input email-signup__input"
      type="email"
      name="contact[email]"
      autocorrect="off"
      autocapitalize="off"
      autocomplete="email"
      placeholder="{{ block.settings.placeholder }}"
      required
      {% if form.errors and form.id == blank %}
      autofocus
      aria-invalid="true"
      aria-describedby="Email-signup__message-error-{{ block.id }}"
      {% elsif form.posted_successfully? and form.id == blank %}
      aria-describedby="Email-signup__message-success-{{ block.id }}"
      {% endif %}>
    <button
      class="custom__email-signup__button"
      {% if block_settings.display_type != 'text' %}
      aria-label="{{ 'actions.sign_up' | t }}"
      {% endif %}>
      {% if block_settings.display_type == 'text' %}
        {{ block_settings.label }}
      {% else %}
        <svg
          viewBox="0 0 20 20"
          xmlns="http://www.w3.org/2000/svg"
          focusable="false"
          aria-hidden="true"
          class="email-signup__button-icon">
          {% render 'icon'
            , icon: 'arrow' %}
        </svg>
      {% endif %}
    </button>
  </div>

  {%- if form.errors and form.id == blank -%}
    <div
      id="Email-signup__message-error-{{ block.id }}"
      class="custom__email-signup__message"
      tabindex="-1">
      <svg
        viewBox="0 0 20 20"
        xmlns="http://www.w3.org/2000/svg"
        focusable="false"
        aria-hidden="true"
        class="icon-error">
        {%- render 'icon'
          , icon: 'error' -%}
      </svg>
      {{- form.errors.translated_fields.email | capitalize }}
      {{ form.errors.messages.email -}}
    </div>
  {%- endif -%}

  {%- if form.posted_successfully? and form.id == blank -%}
    <div
      id="Email-signup__message-success-{{ block.id }}"
      class="custom__email-signup__message"
      tabindex="-1">
      <span class="svg-wrapper icon-success">
        {{ 'icon-checkmark.svg' | inline_asset_content }}
      </span>
      <p class="custom__email-signup__message-text">{{ 'blocks.email_signup.success' | t }}</p>
    </div>
  {%- endif -%}
{% endform %}
{% stylesheet %}
  .custom__email-signup__input-group {
    display: flex;
  }
  .custom_email-signup__form {
    display: flex;
    flex-direction: column;
  }
  .custom__email-signup__input {
    width: 100%;
    max-width: 312px;
    padding: 10px 14px;
    border: none;
    font-size: 16px;
    outline: 1px solid #D5D7DA;
    border-radius: 16px 0 0 16px;
    background-color: #ffffff;
    box-shadow: 0 1 2 0 #0A0D120D;
  }
  .custom__email-signup__input:focus {
    border-color: #bfc0c2;
    border: 1px solid #f2b6d6;
    outline: none;
    box-shadow: 0 0 0 4px #ebf2ff
    , 0 1px 2px #0a0d120d;
  }
  .custom__email-signup__button {
    font-family: Geist;
    font-weight: 500;
    font-style: Medium;
    font-size: 16px;
    leading-trim: NONE;
    line-height: 120%;
    letter-spacing: -0.5%;
    color: #ffffff;
    max-width: 108px;
    padding: 12.5px 16px;
    border-radius: 0 16px 16px 0;
    border: none;
    background-color: #6BB4F3;
    outline: 1px solid #D5EDFF;
  }

{% endstylesheet %}